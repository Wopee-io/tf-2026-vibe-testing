# Your local settings. `npm install` copies this file to `.env`, which git ignores,
# so the values you put there never leave your laptop. Never commit `.env`.

# Wopee.io — used by Exhibit 4 and the Wopee MCP server in `.vscode/mcp.json`.
# Both values come from cmd.wopee.io > your project > More > Settings > API Keys (Generate a new key; it is shown once).
WOPEE_PROJECT_UUID=
WOPEE_API_KEY=
WOPEE_API_URL=https://api.wopee.io

# The API exercise (experiments/2_API). Optional: the fixture reads the app's public key from its own
# traffic. To set it yourself, copy the `apikey` header from DevTools > Network on foodora.lovable.app.
FOODORA_API_KEY=

# The Speed Gap Battle (15:15): remove the # to point every test at the new build.
# FOODORA_URL=https://foodora-new.lovable.app
